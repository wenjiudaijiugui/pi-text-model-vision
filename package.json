{
  "name": "pi-text-model-vision",
  "version": "0.2.0",
  "description": "Give Pi's text-only models visual perception through opencode-go/mimo-v2.5 and original-resolution focused cropping.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "vision",
    "text-only-model",
    "multimodal",
    "image-crop",
    "deepseek",
    "opencode-go"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "focused-read.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "dependencies": {
    "sharp": "0.35.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wenjiudaijiugui/pi-text-model-vision.git"
  },
  "homepage": "https://github.com/wenjiudaijiugui/pi-text-model-vision#readme",
  "bugs": {
    "url": "https://github.com/wenjiudaijiugui/pi-text-model-vision/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
